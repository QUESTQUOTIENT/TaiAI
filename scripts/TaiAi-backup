#!/usr/bin/env python3
"""TaiAi-backup — snapshot + restore of the data directory.

Backs up everything the app keeps under `data/`: the SQLite DB, the
Fernet key, JSON state files, RAG indexes, personal docs, attachments,
WhatsApp session, etc. Output is a gzip tarball — composable with cron
+ scp + s3cmd. The backup uses `sqlite3 .backup` for the DB so the
app can keep running during the snapshot.

    TaiAi-backup snapshot                       # → backups/YYYY-MM-DD-HHMMSS.tar.gz
    TaiAi-backup snapshot --out /mnt/nas/x.tgz
    TaiAi-backup list                           # entries in backups/
    TaiAi-backup restore PATH [--yes]           # overwrite current data/ from a tarball
    TaiAi-backup verify PATH                    # tarball integrity check (no extract)

Restore is destructive: it overwrites `data/` in place. Always pass
`--yes` so a typo can't nuke your live state.
"""

from __future__ import annotations
import sys
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse, json, logging, os, shutil, sqlite3, subprocess, sys, tarfile, tempfile
from datetime import datetime
from pathlib import Path, PurePosixPath

# Reuse the restore-time safety checks (archive-bomb + per-entry caps) from
# the backup service module. Keeping them here would mean two copies; the
# unit tests for those checks live in tests/test_backup_safety.py.
from services.backup import RestoreQuotas, QuotaViolation, enforce_quotas

# Emit PlatformEvents on the shared bus so cross-subsystem diagnostics
# work (e.g. correlating a backup failure with the cookbook install
# that triggered it). The bus import is lazy so a broken core.events
# doesn't take down the backup CLI for operators who don't need it.
try:
    from core.events import EventBus, PlatformEvent, get_default_bus
except ImportError:  # pragma: no cover — exercised only if core.events missing
    EventBus = None  # type: ignore[assignment]
    PlatformEvent = None  # type: ignore[assignment]

    def get_default_bus():  # type: ignore[no-redef]
        return None


def _emit(bus, type_: str, status: str, **payload) -> None:
    """Emit an event if the bus is available; swallow otherwise.

    Backup should work even when the event bus can't be imported (e.g.
    a fresh checkout where core.events.py is missing). Operators who
    never look at the bus won't notice; the bus subscribers won't see
    anything. Failures inside the bus (e.g. a subscriber raises) are
    swallowed by EventBus.emit itself.
    """
    if bus is None or PlatformEvent is None:
        return
    try:
        bus.emit(PlatformEvent(type=type_, status=status, payload=payload))
    except Exception:  # noqa: BLE001 — never let events break backup
        pass

# Encryption is opt-in. Import lazily so a missing cryptography install
# only breaks `snapshot --encrypt` / `restore` against encrypted blobs,
# not the plaintext path that 99% of existing scripts use.
def _load_crypto():
    try:
        from services.backup import (
            MAGIC as _MAGIC,
            AuthenticationFailedError as _AuthFail,
            HeaderError as _HeaderErr,
            decrypt as _decrypt,
            encrypt as _encrypt,
        )
    except ImportError as e:
        fail(
            "encryption requested but cryptography is not installed "
            "(pip install cryptography)"
        )
    return _MAGIC, _AuthFail, _HeaderErr, _decrypt, _encrypt


def _read_passphrase(args, *, what: str) -> bytes:
    """Read the encryption passphrase from --passphrase-file.

    We deliberately do NOT accept it on the command line or via env var:
    both end up in process listings / shell history / crash dumps.
    The file mode is 0600-checked so a world-readable file is rejected
    up front — backups of private data shouldn't be unlockable by any
    local user.
    """
    path = getattr(args, "passphrase_file", None)
    if not path:
        fail(f"--passphrase-file is required to {what} an encrypted backup")
    p = Path(path)
    if not p.is_file():
        fail(f"no passphrase file at {p}")
    # POSIX file-mode check. On Windows the call returns a permission
    # bitfield but doesn't enforce 0600; we still try and warn.
    try:
        mode = p.stat().st_mode
        if hasattr(os, "getuid") and (mode & 0o077) != 0:
            fail(
                f"passphrase file {p} is world/group readable "
                f"(mode {oct(mode & 0o777)}); chmod 600 and retry"
            )
    except OSError:
        pass
    try:
        data = p.read_bytes()
    except OSError as e:
        fail(f"could not read passphrase file {p}: {e}")
    if not data:
        fail(f"passphrase file {p} is empty")
    return data.rstrip(b"\r\n")

_DATA_DIR = _REPO_ROOT / "data"
_BACKUP_DIR = _REPO_ROOT / "backups"

# Stuff inside data/ that we explicitly skip — anything we can re-derive
# from the SQLite DB + JSON state. Keeps the tarball small.
_SKIP_PATTERNS = {
    "mail-attachments",     # cached IMAP attachment extractions
    "deep_research",        # research runs are large; back up explicitly via --include-research
    "personal_uploads",     # uploaded files; usually wanted, included by default actually
}


def _sqlite_safe_copy(src: Path, dst: Path) -> None:
    """Use SQLite's `.backup` API instead of a file copy so a write
    in-flight doesn't corrupt the snapshot. Falls back to plain copy
    if the file isn't a SQLite DB."""
    try:
        src_conn = sqlite3.connect(str(src))
        dst_conn = sqlite3.connect(str(dst))
        with dst_conn:
            src_conn.backup(dst_conn)
        src_conn.close()
        dst_conn.close()
    except Exception:
        # Not a SQLite DB or backup unsupported — fall back.
        dst.write_bytes(src.read_bytes())


def _reject_output_inside_data(out_path: Path) -> None:
    try:
        resolved = out_path.resolve()
        data_root = _DATA_DIR.resolve()
        resolved.relative_to(data_root)
    except ValueError:
        return
    fail("backup output path must be outside data/")


def cmd_snapshot(args):
    """Write a tar.gz of the entire data/ directory.

    SQLite databases are dumped via .backup() into a temp file before
    being added to the tar, so a running web app can't corrupt the
    snapshot. Everything else is copied as-is."""
    bus = get_default_bus()
    encrypted = bool(getattr(args, "encrypt", False))
    out_path = Path(args.out) if args.out else (
        _BACKUP_DIR / f"TaiAi-backup-{datetime.now().strftime('%Y%m%d-%H%M%S')}.tar.gz"
    )
    _emit(bus, "backup.snapshot.started", "started",
          out=str(out_path), encrypted=encrypted)
    if not _DATA_DIR.is_dir():
        _emit(bus, "backup.snapshot.failed", "failed",
              out=str(out_path), reason="no_data_dir")
        fail(f"no data dir at {_DATA_DIR}")
    _BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    _reject_output_inside_data(out_path)
    out_path.parent.mkdir(parents=True, exist_ok=True)

    sqlite_dbs = [p for p in _DATA_DIR.rglob("*.db") if p.is_file() and not p.is_symlink()]
    files_added = 0
    total_bytes = 0

    with tempfile.TemporaryDirectory() as tmp_str:
        tmp = Path(tmp_str)
        # Snapshot SQLite DBs to the temp dir first.
        db_map: dict[Path, Path] = {}
        for db in sqlite_dbs:
            rel = db.relative_to(_DATA_DIR)
            staged = tmp / rel
            staged.parent.mkdir(parents=True, exist_ok=True)
            _sqlite_safe_copy(db, staged)
            db_map[db] = staged

        with tarfile.open(out_path, "w:gz") as tar:
            for p in sorted(_DATA_DIR.rglob("*")):
                if not p.is_file() or p.is_symlink():
                    continue
                rel = p.relative_to(_DATA_DIR.parent)
                # Skip user-asked-to-skip categories
                if not args.include_research and "deep_research" in rel.parts:
                    continue
                if not args.include_attachments and "mail-attachments" in rel.parts:
                    continue
                # Substitute SQLite snapshots for the live files
                source = db_map.get(p, p)
                tar.add(source, arcname=str(rel))
                files_added += 1
                try:
                    total_bytes += source.stat().st_size
                except Exception:
                    pass

    # Optional encryption: rewrite the tarball through the AES-GCM
    # envelope. We do this *after* the tarfile context closes so the
    # in-flight gz file isn't read while another writer holds it.
    did_encrypt = False
    if encrypted:
        MAGIC, _AuthFail, _HeaderErr, _decrypt, _encrypt = _load_crypto()
        passphrase = _read_passphrase(args, what="create")
        raw = out_path.read_bytes()
        out_path.write_bytes(_encrypt(raw, passphrase))
        try:
            os.remove(tmp / "encrypted.tmp")  # belt + braces
        except OSError:
            pass
        did_encrypt = True

    out_bytes = out_path.stat().st_size
    _emit(bus, "backup.snapshot.completed", "succeeded",
          out=str(out_path), files=files_added, encrypted=did_encrypt,
          compressed_bytes=out_bytes, uncompressed_bytes=total_bytes)
    emit({
        "ok": True,
        "path": str(out_path),
        "files": files_added,
        "uncompressed_bytes": total_bytes,
        "compressed_bytes": out_bytes,
        "ratio": round(out_bytes / max(total_bytes, 1), 4),
        "included_research": bool(args.include_research),
        "included_attachments": bool(args.include_attachments),
        "encrypted": did_encrypt,
    }, args)


def cmd_list(args):
    """List entries in `backups/`. Most recent first."""
    if not _BACKUP_DIR.is_dir():
        emit([], args)
        return
    entries = []
    for p in sorted(_BACKUP_DIR.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True):
        if not p.is_file():
            continue
        entries.append({
            "path": str(p),
            "name": p.name,
            "bytes": p.stat().st_size,
            "modified": datetime.fromtimestamp(p.stat().st_mtime).isoformat(),
        })
    emit(entries, args)


def cmd_verify(args):
    """Open the tarball read-only and walk its members — confirms
    integrity without extracting anything."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    try:
        with tarfile.open(path, "r:gz") as tar:
            members = tar.getmembers()
            _validate_restore_members(members)
    except (tarfile.TarError, OSError) as e:
        fail(f"tarball is corrupt: {e}")
    emit({
        "ok": True,
        "path": str(path),
        "members": len(members),
        "first": members[0].name if members else None,
        "last": members[-1].name if members else None,
    }, args)


def _validate_restore_members(members):
    """Reject archive entries that can escape data/ during restore."""
    for m in members:
        rel = PurePosixPath(m.name)
        if rel.is_absolute() or ".." in rel.parts:
            fail(f"refusing tarball with absolute/parent path: {m.name!r}")
        if not rel.parts or rel.parts[0] != "data":
            fail(f"refusing tarball with entry outside data/: {m.name!r}")
        if m.issym() or m.islnk():
            fail(f"refusing tarball with link entry: {m.name!r}")
        if not (m.isdir() or m.isfile()):
            fail(f"refusing tarball with special file entry: {m.name!r}")


def _extract_restore_members(tar, members, root: Path) -> None:
    """Extract only regular files/directories after validation."""
    for m in members:
        target = root.joinpath(*PurePosixPath(m.name).parts)
        if m.isdir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        src = tar.extractfile(m)
        if src is None:
            fail(f"extract failed: could not read {m.name!r}")
        with src, open(target, "wb") as dst:
            shutil.copyfileobj(src, dst)


def cmd_restore(args):
    """Overwrite `data/` from a tarball. Destructive; requires --yes.

    With ``--preview``, walks the (possibly-encrypted) tarball and
    returns what *would* be extracted without touching the filesystem:
    no stash rename, no writes. Quota + traversal checks still run so
    a hostile archive is rejected before the preview prints anything.
    """
    bus = get_default_bus()
    path = Path(args.path)
    preview = bool(getattr(args, "preview", False))
    _emit(bus, "backup.restore.started", "started",
          archive=str(path), preview=preview)
    if not path.exists():
        _emit(bus, "backup.restore.failed", "failed",
              archive=str(path), reason="missing_archive")
        fail(f"no file at {path}")
    if not preview and not args.yes:
        _emit(bus, "backup.restore.failed", "failed",
              archive=str(path), reason="missing_yes_confirmation")
        fail("restore is destructive — pass --yes to confirm overwriting data/")

    raw = path.read_bytes()
    # Transparent decrypt: if the first 4 bytes are our magic, the blob
    # is an AES-GCM envelope. Anything else is treated as a plain
    # gzip tarball (existing behaviour, unchanged).
    try:
        MAGIC, _AuthFail, _HeaderErr, _decrypt, _encrypt = _load_crypto()
    except SystemExit:
        # cryptography missing — encryption path unavailable, but a
        # plaintext backup is still restorable, so let it through.
        MAGIC = None

    encrypted = False
    if MAGIC is not None and raw[:4] == MAGIC:
        encrypted = True
        passphrase = _read_passphrase(args, what="restore")
        try:
            raw = _decrypt(raw, passphrase)
        except (_AuthFail, _HeaderErr) as e:
            _emit(bus, "backup.restore.failed", "failed",
                  archive=str(path), reason="decrypt_failed",
                  error=str(e), encrypted=True)
            fail(f"could not decrypt {path}: {e}")

    # Re-wrap the (possibly decrypted) bytes in a tarfile handle so the
    # rest of the restore logic can stay unchanged. We do this via a
    # BytesIO so tarfile.open can introspect the header cleanly.
    import io as _io
    tar_buf = _io.BytesIO(raw)

    # Sanity check: tarball entries must all be safe, regular files/dirs under
    # `data/`. Avoid extractall() so symlink/hardlink entries can't redirect a
    # later write outside the repo.
    stash = None
    # Build the quota budget from CLI flags. The defaults in RestoreQuotas
    # are tuned for multi-GB data dirs; flags let paranoid operators tighten
    # them without code changes. We use ``getattr`` with defaults so
    # unit tests that build a bare ``SimpleNamespace`` (without going
    # through the argparse parser) still work — the defaults are
    # intentionally generous.
    quotas = RestoreQuotas(
        max_entries=int(getattr(args, "max_entries", RestoreQuotas.max_entries)),
        max_uncompressed_bytes=int(
            getattr(args, "max_uncompressed_mb",
                    RestoreQuotas.max_uncompressed_bytes // (1024 * 1024))
            * 1024 * 1024
        ),
        max_compression_ratio=float(
            getattr(args, "max_ratio", RestoreQuotas.max_compression_ratio)
        ),
    )
    with tarfile.open(fileobj=tar_buf, mode="r:gz") as tar:
        members = tar.getmembers()
        _validate_restore_members(members)
        try:
            # After decryption the on-disk size no longer reflects the
            # compressed size we have on hand — pass 0 to skip the ratio
            # check (size cap still enforced above).
            enforce_quotas(members, compressed_size=0, quotas=quotas)
        except QuotaViolation as e:
            # Quota failures refuse the archive up-front — current data/ is
            # left in place so the operator can investigate.
            _emit(bus, "backup.restore.failed", "failed",
                  archive=str(path), reason=f"quota:{e.code}",
                  quota_message=e.message, encrypted=encrypted)
            fail(f"refusing restore — quota violation [{e.code}]: {e.message}")

        if preview:
            # Dry-run: summarise what *would* be written and exit
            # without touching the filesystem.
            total_bytes = sum(m.size for m in members)
            file_count = sum(1 for m in members if m.isfile())
            dir_count = sum(1 for m in members if m.isdir())
            sample = [
                {
                    "name": m.name,
                    "size": m.size,
                    "type": "dir" if m.isdir() else "file",
                }
                for m in members[:50]
            ]
            _emit(bus, "backup.restore.previewed", "succeeded",
                  archive=str(path), encrypted=encrypted,
                  entries=len(members), files=file_count, dirs=dir_count,
                  uncompressed_bytes=total_bytes)
            emit({
                "ok": True,
                "preview": True,
                "would_restore_from": str(path),
                "encrypted": encrypted,
                "entries": len(members),
                "files": file_count,
                "dirs": dir_count,
                "uncompressed_bytes": total_bytes,
                "sample": sample,
                "truncated": len(members) > 50,
            }, args)
            return

        # Save a safety copy of current data/ before extracting.
        if _DATA_DIR.exists() or _DATA_DIR.is_symlink():
            stash = _REPO_ROOT / f"data.before-restore-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
            os.rename(_DATA_DIR, stash)
        try:
            _extract_restore_members(tar, members, _REPO_ROOT)
        except Exception as e:
            _emit(bus, "backup.restore.failed", "failed",
                  archive=str(path), reason="extract_failed",
                  error=str(e), encrypted=encrypted)
            fail(f"extract failed: {e}")
    _emit(bus, "backup.restore.completed", "succeeded",
          archive=str(path), encrypted=encrypted,
          stashed_at=str(stash) if stash else None,
          entries=len(members))
    emit({
        "ok": True,
        "restored_from": str(path),
        "previous_data_stashed_at": str(stash) if stash else None,
        "encrypted": encrypted,
    }, args)


def _build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true")
    p = argparse.ArgumentParser(prog="TaiAi-backup", parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)

    ps = sub.add_parser("snapshot", parents=[common])
    ps.add_argument("--out", help="output path (default: backups/<timestamp>.tar.gz)")
    ps.add_argument("--include-research", action="store_true",
                    help="include data/deep_research/ (skipped by default; large)")
    ps.add_argument("--include-attachments", action="store_true",
                    help="include data/mail-attachments/ (skipped by default; re-derivable)")
    # Encryption is opt-in. Without --encrypt the snapshot is the
    # backwards-compatible plaintext gzip tarball existing tooling
    # already consumes.
    ps.add_argument("--encrypt", action="store_true",
                    help="wrap the tarball in AES-256-GCM with a passphrase-derived key")
    ps.add_argument("--passphrase-file", metavar="PATH",
                    help="path to a file containing the encryption passphrase "
                         "(required with --encrypt; mode 0600 enforced)")
    ps.set_defaults(func=cmd_snapshot)

    pl = sub.add_parser("list", parents=[common])
    pl.set_defaults(func=cmd_list)

    pv = sub.add_parser("verify", parents=[common])
    pv.add_argument("path")
    pv.set_defaults(func=cmd_verify)

    pr = sub.add_parser("restore", parents=[common])
    pr.add_argument("path")
    pr.add_argument("--yes", action="store_true",
                    help="confirm overwriting current data/")
    # --preview walks the tarball, runs quota + traversal checks, and
    # prints a summary of what would be extracted — without touching
    # the filesystem or stashing the current data/ directory.
    pr.add_argument("--preview", action="store_true",
                    help="dry-run: report what would be restored, do not write")
    # Archive-bomb / quota controls. Defaults are intentionally generous;
    # CI / hardened deployments should pass smaller caps.
    pr.add_argument("--max-entries", type=int, default=RestoreQuotas.max_entries,
                    help=f"hard cap on tarball member count (default {RestoreQuotas.max_entries})")
    pr.add_argument("--max-uncompressed-mb", type=int,
                    default=RestoreQuotas.max_uncompressed_bytes // (1024 * 1024),
                    help=f"hard cap on uncompressed total in MB (default {RestoreQuotas.max_uncompressed_bytes // (1024 * 1024)})")
    pr.add_argument("--max-ratio", type=float, default=RestoreQuotas.max_compression_ratio,
                    help=f"max compression ratio uncompressed/compressed (default {RestoreQuotas.max_compression_ratio})")
    # Auto-detected at read time: if the file's magic is TAIB, decrypt
    # transparently before quota + traversal checks. The passphrase is
    # only needed when the blob is encrypted.
    pr.add_argument("--passphrase-file", metavar="PATH",
                    help="path to a file containing the decryption passphrase "
                         "(required if the backup is encrypted)")
    pr.set_defaults(func=cmd_restore)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
